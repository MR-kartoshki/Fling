{
	"schemaVersion": 1,
	"id": "fling",
	"version": "${version}",
	"name": "Fling",
	"description": "Fling your items!",
	"authors": [
		"MR-kartoshki"
	],
	"contact": {
		"sources": "https://github.com/MR-kartoshki/Fling"
	},
	"license": "MIT",
	"icon": "assets/fling/icon.png",
